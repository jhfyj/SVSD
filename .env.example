# Google Maps: copy this file to .env.local and fill in (see README, "Google Maps").

# Browser key: loads the map. Restrict it to your site's URLs and to "Maps JavaScript API".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a vector Map ID with your black-and-white style. Leave empty to use Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: server key for address search and routes (Places API (New), Routes API).
# Leave empty to reuse the browser key, which then needs those two APIs enabled too.
GOOGLE_MAPS_SERVER_KEY=
